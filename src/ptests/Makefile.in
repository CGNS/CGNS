NO_COLOR=\033[0m
OK_COLOR=\033[32;01m
ERROR_COLOR=\033[31;01m

CGNSDIR = ..
include $(CGNSDIR)/make.defs

CGNSLIB = $(CGNSDIR)/$(LIBCGNS)

COPTS  = $(CFLAGS) -I$(CGNSDIR) -I$(CGNSDIR)/tests $(MPIINC) @BUILDOPTS@
FOPTS  = $(FFLAGS) -I$(CGNSDIR) $(MPIINC)
LDLIBS = $(CGNSLIB) $(BUILDLIBS)

#----------

CALL =	pcgns_ctest$(EXE) \
	test_multisets$(EXE) \
	cexample$(EXE) \
	benchmark$(EXE) \
	benchmark_hdf5$(EXE) \
	open_close$(EXE) \
        comm_test$(EXE) \
	test_base$(EXE) \
	test_unstructured$(EXE) \
	test_unstruc_quad$(EXE) \
	test_zone$(EXE) \
	test_general_readwrite$(EXE) \
        Metadata_Stressing$(EXE) \
	test_poly_unstructured$(EXE) \
	para_high_order$(EXE) \
	test_high_order_parallel$(EXE) \
	test_charlen_parallel$(EXE) \
	test_mixed_par_ser$(EXE) \
	thesis_benchmark$(EXE)

# pcgns_unicode_test requires HDF5 >= 2.0.0 for Unicode filepath support.
# It is not included in the default test run; build and run it manually:
#   make pcgns_unicode_test && mpiexec -n 2 ./pcgns_unicode_test
HDF5_UNICODE_TESTS = pcgns_unicode_test$(EXE)

FALL =	pcgns_ftest$(EXE) \
	ftest_zone$(EXE) \
	fexample$(EXE) \
	benchmark_hdf5_f90$(EXE) \
	test_mixed_par_ser_f90$(EXE) \
	test_unstruc_quad_f90$(EXE) \
	test_poly_unstructured_f90$(EXE) \
	test_general_wrappers_f90$(EXE)

ALL   = $(CALL) @FALL@
TESTS = $(ALL)

TIMING_AVAIL:=$(shell /usr/bin/time -a -o CGNS_timing.txt -f "%e" pwd > /dev/null; echo $$?)
ifeq ("$(TIMING_AVAIL)" , "0")
  TIMING = /usr/bin/time -a -o CGNS_timing.txt -f "$$x %e" $(MPIEXEC) ./$$x >/dev/null 2>&1
  TIMING_ARGS = /usr/bin/time -a -o CGNS_timing.txt -f "$$x %e" $(MPIEXEC) ./$$x $$args >/dev/null 2>&1
else
  TIMING = $(MPIEXEC) ./$$x >/dev/null 2>&1
  TIMING_ARGS = $(MPIEXEC) ./$$x $$args >/dev/null 2>&1
endif

all : $(ALL)

#----------

test : $(TESTS)
	@echo " "; \
	status=0; \
	echo "=== running parallel tests ==="; \
	if test -f CGNS_timing.txt; then \
	  $(RM) CGNS_timing.txt; \
	fi; \
	padlimit=40; \
	pad=$$(printf '%*s' "$$padlimit"); \
	pad=$${pad// /.}; \
        padlength=32; \
	time=""; \
	for x in $(TESTS) ; do \
           args=""; \
           if test "$$x" = "Metadata_Stressing$(EXE)" ; then \
		for n in 1 2 ; do \
	           printf "$$x"; \
	           printf ' %*.*s' 0 $$((padlength - $${#x} )) "$$pad"; \
	           if `$(TIMING_ARGS)` ; then \
	             printf " [$(OK_COLOR)PASSED$(NO_COLOR)]"; \
                     if [ -f "CGNS_timing.txt" ]; then \
                       itime=$$(tail -n1 CGNS_timing.txt |  awk  '{print $$2}' | sed -e 's/$$/ sec/'); \
	               printf " %+12s" "$$itime";\
                     fi; \
                     printf "\n";\
	           else \
	              printf " [$(ERROR_COLOR)FAILED$(NO_COLOR)]\n"; \
                      status=`expr $$status + 1`; \
	            fi; \
	            args="-sec2"; \
		done;\
           else \
	     printf "$$x"; \
	     printf ' %*.*s' 0 $$((padlength - $${#x} )) "$$pad"; \
	     if `$(TIMING)` ; then \
	       printf " [$(OK_COLOR)PASSED$(NO_COLOR)]"; \
               if [ -f "CGNS_timing.txt" ]; then \
                 itime=$$(tail -n1 CGNS_timing.txt |  awk  '{print $$2}' | sed -e 's/$$/ sec/'); \
	         printf " %+12s" "$$itime";\
               fi; \
               printf "\n";\
	     else \
	       printf " [$(ERROR_COLOR)FAILED$(NO_COLOR)]\n"; \
               status=`expr $$status + 1`; \
	     fi; \
           fi;\
	 done; \
	 echo "=== finished ==="; \
         if [ $$status -ne 0 ]; then \
           printf "$(ERROR_COLOR)"; \
	   stat=1; \
         else \
           printf "$(OK_COLOR)"; \
	   stat=0; \
         fi; \
         printf "$$status tests failed $(NO_COLOR) \n"; \
	 exit $$stat;

#----------

# Pattern rule for all single-source C tests
%$(EXE) : %.c $(CGNSLIB)
	$(CC) $(COPTS) $(CEOUT)$@ $< $(LDLIBS) $(CLIBS)
	$(STRIP) $@

#----------

para_high_order$(EXE) : para_high_order.c $(CGNSLIB)
	$(CC) $(COPTS) $(CEOUT)$@ para_high_order.c $(LDLIBS) $(CLIBS)
	$(STRIP) $@

#----------

test_charlen_parallel$(EXE) : test_charlen_parallel.c $(CGNSLIB)
	$(CC) $(COPTS) $(CEOUT)$@ test_charlen_parallel.c $(LDLIBS) $(CLIBS)
	$(STRIP) $@

#----------

test_high_order_parallel$(EXE) : test_high_order_parallel.c $(CGNSLIB)
	$(CC) $(COPTS) $(CEOUT)$@ test_high_order_parallel.c $(LDLIBS) $(CLIBS)
	$(STRIP) $@

#----------

pcgns_ftest$(EXE) : pcgns_ftest.F90 utilsf.$(O) $(CGNSLIB)
	$(F77) $(FOPTS) $(FEOUT)$@ pcgns_ftest.F90 utilsf.$(O) $(LDLIBS) $(FLIBS)
	$(STRIP) $@

#----------

test_mixed_par_ser_f90$(EXE) : test_mixed_par_ser_f90.F90 $(CGNSLIB)
	$(F77) $(FOPTS) $(FEOUT)$@ test_mixed_par_ser_f90.F90 $(LDLIBS) $(FLIBS)
	$(STRIP) $@

#----------

ftest_zone$(EXE) : ftest_zone.F90 $(CGNSLIB)
	$(F77) $(FOPTS) $(FEOUT)$@ ftest_zone.F90 $(LDLIBS) $(FLIBS)
	$(STRIP) $@

#----------

fexample$(EXE) : fexample.F90 $(CGNSLIB)
	$(F77) $(FOPTS) $(FEOUT)$@ fexample.F90 $(LDLIBS) $(FLIBS)
	$(STRIP) $@

#----------

benchmark_hdf5_f90$(EXE) : benchmark_hdf5_f90.F90 $(CGNSLIB)
	$(F77) $(FOPTS) $(FEOUT)$@ benchmark_hdf5_f90.F90 $(LDLIBS) $(FLIBS)
	$(STRIP) $@

#----------

test_unstruc_quad_f90$(EXE) : test_unstruc_quad_f90.F90 $(CGNSLIB)
	$(F77) $(FOPTS) $(FEOUT)$@ test_unstruc_quad_f90.F90 $(LDLIBS) $(FLIBS)
	$(STRIP) $@

#----------

test_poly_unstructured_f90$(EXE) : test_poly_unstructured_f90.F90 utilsf.$(O) $(CGNSLIB)
	$(F77) $(FOPTS) $(FEOUT)$@ test_poly_unstructured_f90.F90 utilsf.$(O) $(LDLIBS) $(FLIBS)
	$(STRIP) $@

#----------

test_general_wrappers_f90$(EXE) : test_general_wrappers_f90.F90 utilsf.$(O) $(CGNSLIB)
	$(F77) $(FOPTS) $(FEOUT)$@ test_general_wrappers_f90.F90 utilsf.$(O) $(LDLIBS) $(FLIBS)
	$(STRIP) $@

#----------

Metadata_Stressing$(EXE) : Metadata_Stressing.c $(CGNSLIB)
	$(CC) $(COPTS) $(CEOUT)$@ Metadata_Stressing.c $(LDLIBS) $(CLIBS)
	$(STRIP) $@

#----------

pcgns_unicode_test$(EXE) : pcgns_unicode_test.c $(CGNSLIB)
	$(CC) $(COPTS) $(CEOUT)$@ pcgns_unicode_test.c $(LDLIBS) $(CLIBS)
	$(STRIP) $@

#----------


utilsf.$(O) : $(CGNSDIR)/tests/utilsf.F90
	$(F77) $(FOPTS) -c $(CGNSDIR)/tests/utilsf.F90

clean :
	-$(RM) *.$(O) *.mod *.MOD

allclean : clean
	-$(RM) $(ALL)
	-$(RM) *~ *.bak
	-$(RM) *.cgns *.cg?
	-$(RM) CGNS_timing.txt
	-$(RM) -r $(shell printf '\xc3\xa9coulement_par')

