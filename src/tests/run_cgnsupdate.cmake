# Each CTest has its own directory. Never run the update on the source fixture.
file(MAKE_DIRECTORY "${WORK}")
file(REMOVE "${WORK}/input.cgns" "${WORK}/updated.cgns")
file(SHA256 "${FIXTURE}" original_hash)

function(run_checked)
  execute_process(COMMAND ${ARGV} WORKING_DIRECTORY "${WORK}" TIMEOUT 60
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(NOT status STREQUAL "0")
    message(FATAL_ERROR "${ARGV} failed (${status}): ${output}\n${errors}")
  endif()
endfunction()

if(BACKEND STREQUAL "adf")
  run_checked("${CONVERT_TOOL}" -a "${FIXTURE}" input.cgns)
else()
  configure_file("${FIXTURE}" "${WORK}/input.cgns" COPYONLY)
endif()
file(SHA256 "${WORK}/input.cgns" before_hash)
# The shipped wrapper looks for cgnscheck beside itself.
file(COPY "${CHECK_TOOL}" DESTINATION "${WORK}" USE_SOURCE_PERMISSIONS)
if(WIN32)
  configure_file("${TOOLS_SOURCE}/cgnsupdate.bat" "${WORK}/cgnsupdate.bat" COPYONLY)
  run_checked(cmd /d /c cgnsupdate.bat input.cgns updated.cgns)
else()
  configure_file("${TOOLS_SOURCE}/cgnsupdate" "${WORK}/cgnsupdate" COPYONLY)
  run_checked(sh ./cgnsupdate input.cgns updated.cgns)
endif()
run_checked("${COMPARE_TOOL}" input.cgns updated.cgns "${BACKEND}" "${OLD_VERSION}")
file(SHA256 "${WORK}/input.cgns" after_hash)
file(SHA256 "${FIXTURE}" final_hash)
if(NOT before_hash STREQUAL after_hash OR NOT original_hash STREQUAL final_hash)
  message(FATAL_ERROR "cgnsupdate modified its input")
endif()
