@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

string(TOUPPER @CGNS_PACKAGE@ CGNS_PACKAGE_NAME)

set (${CGNS_PACKAGE_NAME}_VALID_COMPONENTS
    static
    shared
)

#-----------------------------------------------------------------------------
# User Options
#-----------------------------------------------------------------------------
# Languages:
#-----------------------------------------------------------------------------
set (${CGNS_PACKAGE_NAME}_BUILD_FORTRAN        @CGNS_ENABLE_FORTRAN@)
#-----------------------------------------------------------------------------
# Features:
#-----------------------------------------------------------------------------
set (${CGNS_PACKAGE_NAME}_BUILD_SHARED_LIBS     @CGNS_ENABLE_SHARED_LIB@)
set (${CGNS_PACKAGE_NAME}_BUILD_STATIC_LIBS     @CGNS_ENABLE_STATIC_LIB@)
set (${CGNS_PACKAGE_NAME}_BUILD_64BIT           @CGNS_ENABLE_64BIT@)
#-----------------------------------------------------------------------------
set (${CGNS_PACKAGE_NAME}_ENABLE_HDF5_SUPPORT   @CGNS_ENABLE_HDF5@)
set (${CGNS_PACKAGE_NAME}_HDF5_LINK_TYPE       "@CG_HDF5_LINK_TYPE@")
#-----------------------------------------------------------------------------
set (${CGNS_PACKAGE_NAME}_ARCHITECTURE         "@CMAKE_GENERATOR_ARCHITECTURE@")
set (${CGNS_PACKAGE_NAME}_TOOLSET              "@CMAKE_GENERATOR_TOOLSET@")

#-----------------------------------------------------------------------------
# Dependencies
#-----------------------------------------------------------------------------
if (${CGNS_PACKAGE_NAME}_ENABLE_PARALLEL)
  set (${CGNS_PACKAGE_NAME}_MPI_C_INCLUDE_PATH "@MPI_INC@")
  set (${CGNS_PACKAGE_NAME}_MPI_C_LIBRARIES    "@MPI_LIBS@")

  enable_language(C) # for MPI::MPI_C
  find_package(MPI QUIET REQUIRED)
endif ()
#-----------------------------------------------------------------------------

# Handle default component(static) :
if (NOT ${CGNS_PACKAGE_NAME}_FIND_COMPONENTS)
  if (${CGNS_PACKAGE_NAME}_BUILD_STATIC_LIBS)
    set (${CGNS_PACKAGE_NAME}_LIB_TYPE)
    set (${CGNS_PACKAGE_NAME}_FIND_COMPONENTS C static)
    set (${CGNS_PACKAGE_NAME}_FIND_REQUIRED_static_C true)
  else ()
    set (${CGNS_PACKAGE_NAME}_LIB_TYPE)
    set (${CGNS_PACKAGE_NAME}_FIND_COMPONENTS C shared)
    set (${CGNS_PACKAGE_NAME}_FIND_REQUIRED_shared_C true)
  endif ()
endif ()

# Handle requested components:
list (REMOVE_DUPLICATES ${CGNS_PACKAGE_NAME}_FIND_COMPONENTS)
foreach (comp IN LISTS ${CGNS_PACKAGE_NAME}_FIND_COMPONENTS)
  if (comp STREQUAL "shared")
    list (REMOVE_ITEM ${CGNS_PACKAGE_NAME}_FIND_COMPONENTS ${comp})
    set (${CGNS_PACKAGE_NAME}_LIB_TYPE ${${CGNS_PACKAGE_NAME}_LIB_TYPE} ${comp})
  elseif (comp STREQUAL "static")
    list (REMOVE_ITEM ${CGNS_PACKAGE_NAME}_FIND_COMPONENTS ${comp})
    set (${CGNS_PACKAGE_NAME}_LIB_TYPE ${${CGNS_PACKAGE_NAME}_LIB_TYPE} ${comp})
  endif ()
endforeach ()

#-----------------------------------------------------------------------------
# Resolve HDF5 dependency BEFORE including cgns-targets.cmake
# This ensures hdf5-static/hdf5-shared targets exist when cgns targets are loaded
#-----------------------------------------------------------------------------
if (${CGNS_PACKAGE_NAME}_ENABLE_HDF5_SUPPORT)
  # Determine which HDF5 link type to find
  if (${CGNS_PACKAGE_NAME}_HDF5_LINK_TYPE STREQUAL "shared")
    set (HDF5_USE_STATIC_LIBRARIES OFF)
    find_dependency(HDF5)
    if (HDF5_FOUND AND NOT TARGET hdf5-shared)
      message (STATUS " HDF5 was found but not hdf5-shared target, creating fallback target")
      add_library(hdf5-shared INTERFACE IMPORTED)
      string(REPLACE "-D" "" _hdf5_definitions "${HDF5_DEFINITIONS}")
      set_target_properties(hdf5-shared PROPERTIES
                          INTERFACE_LINK_LIBRARIES "${HDF5_LIBRARIES}"
                          INTERFACE_INCLUDE_DIRECTORIES "${HDF5_INCLUDE_DIRS}"
                          INTERFACE_COMPILE_DEFINITIONS "${_hdf5_definitions};H5_BUILT_AS_DYNAMIC_LIB")
    endif()
  elseif (${CGNS_PACKAGE_NAME}_HDF5_LINK_TYPE STREQUAL "static")
    set (HDF5_USE_STATIC_LIBRARIES ON)
    find_dependency(HDF5)
    if (HDF5_FOUND AND NOT TARGET hdf5-static)
      message (STATUS " HDF5 was found but not hdf5-static target, creating fallback target")
      add_library(hdf5-static INTERFACE IMPORTED)
      string(REPLACE "-D" "" _hdf5_definitions "${HDF5_DEFINITIONS}")
      set_target_properties(hdf5-static PROPERTIES
                          INTERFACE_LINK_LIBRARIES "${HDF5_LIBRARIES}"
                          INTERFACE_INCLUDE_DIRECTORIES "${HDF5_INCLUDE_DIRS}"
                          INTERFACE_COMPILE_DEFINITIONS "${_hdf5_definitions};H5_BUILT_AS_STATIC_LIB")
      # If HDF5 needs ZLIB, but ZLIB is an external package not provided by hdf5
      # a ZLIB dependency should be added.
      if (HDF5_ENABLE_ZLIB_SUPPORT AND NOT HDF5_PACKAGE_EXTLIBS)
        message(STATUS "hdf5-static target needs ZLIB through an external library")
        find_package(ZLIB)
      endif ()
      if (HDF5_ENABLE_SZIP_SUPPORT AND NOT HDF5_PACKAGE_EXTLIBS)
        message(STATUS "hdf5-static target needs SZIP through external libraries")
        find_package(libaec)
      endif()
    endif()
  endif()
endif()
#-----------------------------------------------------------------------------
# Don't include targets if this file is being picked up by another
# project which has already built CGNS as a subproject
#-----------------------------------------------------------------------------
if (NOT TARGET "@CGNS_PACKAGE@")
  include("${CMAKE_CURRENT_LIST_DIR}/cgns-targets.cmake")
endif ()

foreach (libtype IN LISTS ${CGNS_PACKAGE_NAME}_LIB_TYPE)
  check_required_components(${CGNS_PACKAGE_NAME}_${libtype})
endforeach ()
